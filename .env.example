# PostgreSQL database connection URL (required for live data)
# Recommended providers: Supabase (supabase.com), Neon (neon.tech), Railway (railway.app)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# If unset, the site falls back to static seed data — fully functional for preview.
DATABASE_URL=

# Google Gemini Vision API key for AI Face Analysis.
# Get one at https://aistudio.google.com/apikey
# If unset, /api/analyze returns a graceful demo result so the feature still works.
GEMINI_API_KEY=
